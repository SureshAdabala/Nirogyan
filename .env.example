NODE_ENV=development
# Required in hosted production-mode runtimes; use staging or production.
# DEPLOYMENT_ENVIRONMENT=staging
# Immutable source/image identifier exposed only in health/readiness evidence.
# RELEASE_ID=<immutable-release-id>
# NEXT_PUBLIC_RELEASE_ID=<same-immutable-release-id-embedded-in-client-build>
PORT=4000
# The root dev runner gives Next.js its own port so it never inherits PORT.
CLIENT_PORT=3000
HOST=127.0.0.1
# Set to the exact number of trusted reverse-proxy hops in the selected host.
# Keep 0 for direct/local connections; do not use an unbounded `true` trust.
TRUST_PROXY_HOPS=0
# MongoDB Atlas SRV URI. Replace every <placeholder> from Atlas; URL-encode the password.
MONGODB_URI=mongodb+srv://<dbUser>:<urlEncodedPassword>@<cluster-host>/niro_dev?retryWrites=true&w=majority&appName=niro-platform
MONGODB_DB_NAME=niro_dev
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10
# Required to enable assessment/result persistence. Use a policy-approved positive
# number of days; production fails closed if it is absent.
ASSESSMENT_RETENTION_DAYS=<approved-positive-number-of-days>
# Generate separate high-entropy secrets for admin access and refresh JWTs.
AUTH_ACCESS_SECRET=<generate-a-long-random-secret>
AUTH_REFRESH_SECRET=<generate-a-different-long-random-secret>
# Secret used to HMAC-hash anonymous analytics identifiers; never expose to the client.
ANALYTICS_HASH_SECRET=<generate-a-third-long-random-secret>
ANALYTICS_IDENTITY_KEY_VERSION=v1
# Event TTL and reporting policy. Production analytics fails closed unless the
# retention period is explicit. P11 must schedule the guarded rollup command:
# use `--current-day-partial` on a short interval for materialized Today/DAU,
# and run without that flag after local midnight for final/reconciliation days.
ANALYTICS_EVENTS_RETENTION_DAYS=<approved-positive-number-of-days>
ANALYTICS_REPORTING_TIMEZONE=Asia/Kolkata
ANALYTICS_JOB_LEASE_SECONDS=900
ANALYTICS_MIN_COHORT_SIZE=5
# Server-side visitor continuity is a separate privacy gate and defaults false.
# When enabled, all three values are required; raw visitor/session IDs are never stored.
ANALYTICS_VISITOR_PERSISTENCE_ENABLED=false
ANALYTICS_VISITOR_RETENTION_DAYS=<approved-positive-number-of-days>
ANALYTICS_VISITOR_CONSENT_VERSION=<approved-analytics-consent-version>
# Optional public lead capture. Configure both together only after retention and
# consent policy are approved. The consent version is a public identifier, not legal copy.
LEAD_RETENTION_DAYS=<approved-positive-number-of-days>
LEAD_CONSENT_VERSION=<approved-consent-version-identifier>
CORS_ORIGINS=http://localhost:3000
# Local development only: expose exact live draft/current pointers through a
# separate no-store, noindex API. Startup rejects this outside loopback dev.
PUBLIC_TEST_CATALOG_ENABLED=false
# Public-site URLs. API_BASE_URL is used by Next server rendering;
# NEXT_PUBLIC_API_BASE_URL is intentionally embedded in the browser bundle.
API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# First-party anonymous telemetry. Persistent visitor identity remains disabled
# unless the enable flag, approved retention, and public policy/consent version are aligned.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_REPORTING_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_ANALYTICS_VISITOR_PERSISTENCE_ENABLED=false
NEXT_PUBLIC_ANALYTICS_VISITOR_RETENTION_DAYS=
NEXT_PUBLIC_ANALYTICS_VISITOR_CONSENT_VERSION=
# Keep disabled until approved consent wording and retention are configured.
NEXT_PUBLIC_LEAD_CAPTURE_ENABLED=false
NEXT_PUBLIC_LEAD_CONSENT_VERSION=<same-approved-identifier-as-LEAD_CONSENT_VERSION>
NEXT_PUBLIC_LEAD_CONSENT_TEXT=<approved-public-consent-copy>
LOG_LEVEL=info
# Bearer protection for the server-only Prometheus scrape endpoint. Also apply
# a platform network policy; never expose this value to browser code.
# METRICS_SCRAPE_TOKEN=<generate-a-fourth-long-random-secret>
# Generic signed Next revalidation endpoint. Both API worker and Next server
# receive the same secret at runtime; it must never use a NEXT_PUBLIC_ name.
# CACHE_INVALIDATION_ENDPOINT=https://<site-host>/api/v1/internal/revalidate
# CACHE_INVALIDATION_SIGNING_SECRET=<generate-a-fifth-long-random-secret>
CACHE_INVALIDATION_LEASE_SECONDS=60
CACHE_INVALIDATION_BATCH_SIZE=25

# Restore-drill values belong only in an isolated verifier environment with a
# read-only Atlas restore user. Do not place them in normal application pods.
RESTORE_MONGODB_URI=mongodb+srv://<restoreReader>:<urlEncodedPassword>@<restored-cluster-host>/<database>?retryWrites=false&w=majority
RESTORE_MONGODB_DB_NAME=<restored-database-name>
RESTORE_TARGET_LABEL=restore-drill-<ticket-or-date>
