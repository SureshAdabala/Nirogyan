{
  "$schema": "niro-platform/calculator-version.v1",
  "calculatorSlug": "niro-cws",
  "name": "Niro Comprehensive Wellness Score",
  "version": 2,
  "status": "draft",
  "shortDescription": "Interprets your biomarkers across 9 health domains and produces a single wellness score with category, contributors and recommendations.",
  "disclaimers": [
    "This assessment is educational and is not a medical diagnosis. Discuss results with a healthcare professional.",
    "Reference ranges vary between laboratories — your lab report's ranges take precedence for individual interpretation."
  ],

  "NIRO_SOURCE_STATUS": {
    "banner": "SCORING NOW NIRO-DEFINED (v2)",
    "explanation": "All scoring bands, points, adjustments, formulas and categories below are transcribed from the primary Niro source: 'Comprehensive Wellness Score Framework: A Point-Based Assessment of Health Parameters' (Risk Analysis folder, extracted 2026-08-18). Full extraction: research/niro-risk-logic-extraction.md.",
    "governanceCaveat": "The source PDF carries the comment 'This has been rejected because of no stratified ranges available for client'. This configuration therefore represents the DOCUMENTED framework pending Niro's stratified-range revision (clarification N1). Publish only after Niro confirms status.",
    "remainingClarifications": ["N1 rejection/stratification status", "N2 cortisol intake flow", "N4 estradiol postmenopausal band", "C7 required/optional confirmation"]
  },

  "parameters": [
    { "key": "sex", "label": "Sex", "group": "profile", "inputType": "select", "validation": { "required": true },
      "options": [ { "value": "male", "label": "Male" }, { "value": "female", "label": "Female" } ], "order": 1,
      "source": { "type": "niro", "ref": "CWS PDF §4.2 — sex-specific ranges inside parameter bands" } },
    { "key": "age", "label": "Age", "group": "profile", "inputType": "number", "unit": { "canonical": "years" },
      "validation": { "required": true, "min": 18, "max": 120 }, "order": 2,
      "source": { "type": "niro", "ref": "CWS PDF §4.1" } },
    { "key": "heightCm", "label": "Height", "group": "profile", "inputType": "number",
      "unit": { "canonical": "cm", "allowed": [ { "code": "cm", "factor": 1 }, { "code": "in", "factor": 2.54 } ] },
      "validation": { "required": true, "min": 100, "max": 250 }, "order": 3 },
    { "key": "weightKg", "label": "Weight", "group": "profile", "inputType": "number",
      "unit": { "canonical": "kg", "allowed": [ { "code": "kg", "factor": 1 }, { "code": "lb", "factor": 0.4536 } ] },
      "validation": { "required": true, "min": 25, "max": 350 }, "order": 4 },
    { "key": "bmi", "label": "BMI", "group": "profile", "inputType": "derived",
      "derived": { "formula": "weightKg / pow(heightCm / 100, 2)", "dependsOn": ["weightKg", "heightCm"] },
      "unit": { "canonical": "kg/m²" }, "order": 5,
      "source": { "type": "niro", "ref": "CWS PDF §4.3 (WHO categories)" } },
    { "key": "smoking", "label": "Smoking status", "group": "lifestyle", "inputType": "select",
      "validation": { "required": true },
      "options": [
        { "value": "never", "label": "Never smoked" },
        { "value": "former-gt5y", "label": "Former smoker — quit more than 5 years ago" },
        { "value": "former-lt5y", "label": "Former smoker — quit within the last 5 years" },
        { "value": "current-lt10", "label": "Current smoker — fewer than 10 cigarettes/day" },
        { "value": "current-gte10", "label": "Current smoker — 10 or more cigarettes/day" }
      ], "order": 6,
      "source": { "type": "niro", "ref": "CWS PDF §4.4 — five levels" } },
    { "key": "physicalActivity", "label": "Physical activity", "group": "lifestyle", "inputType": "select",
      "validation": { "required": true },
      "options": [
        { "value": "gte150", "label": "150+ minutes moderate activity per week" },
        { "value": "75to149", "label": "75–149 minutes moderate activity per week" },
        { "value": "lt75", "label": "Under 75 minutes per week" },
        { "value": "sedentary", "label": "Sedentary lifestyle" }
      ], "order": 7,
      "source": { "type": "niro", "ref": "CWS PDF §4.5 — four levels incl. negative points" } },
    { "key": "cortisolSampleTime", "label": "Cortisol sample time", "group": "hormonal", "inputType": "select",
      "validation": { "required": false },
      "options": [ { "value": "morning", "label": "Morning (approx. 6–10 a.m.)" }, { "value": "afternoon", "label": "Afternoon" } ],
      "order": 89,
      "source": { "type": "niro", "ref": "CWS PDF §3.9 — separate morning/afternoon optimal ranges (intake flow N2)" } },

    { "key": "totalCholesterol", "label": "Total Cholesterol", "group": "cardiovascular", "biomarkerKey": "total-cholesterol", "inputType": "number",
      "unit": { "canonical": "mg/dL", "allowed": [ { "code": "mg/dL", "factor": 1 }, { "code": "mmol/L", "factor": 38.67 } ] },
      "validation": { "min": 50, "max": 500 }, "missingPolicy": "exclude-from-max", "order": 10 },
    { "key": "hdl", "label": "HDL Cholesterol", "group": "cardiovascular", "biomarkerKey": "hdl-cholesterol", "inputType": "number",
      "unit": { "canonical": "mg/dL", "allowed": [ { "code": "mg/dL", "factor": 1 }, { "code": "mmol/L", "factor": 38.67 } ] },
      "validation": { "min": 5, "max": 150 }, "missingPolicy": "exclude-from-max", "order": 11 },
    { "key": "ldl", "label": "LDL Cholesterol", "group": "cardiovascular", "biomarkerKey": "ldl-cholesterol", "inputType": "number",
      "unit": { "canonical": "mg/dL", "allowed": [ { "code": "mg/dL", "factor": 1 }, { "code": "mmol/L", "factor": 38.67 } ] },
      "validation": { "min": 20, "max": 400 }, "missingPolicy": "exclude-from-max", "order": 12 },
    { "key": "triglycerides", "label": "Triglycerides", "group": "cardiovascular", "biomarkerKey": "triglycerides", "inputType": "number",
      "unit": { "canonical": "mg/dL", "allowed": [ { "code": "mg/dL", "factor": 1 }, { "code": "mmol/L", "factor": 88.57 } ] },
      "validation": { "min": 20, "max": 2000 }, "missingPolicy": "exclude-from-max", "order": 13 },
    { "key": "systolicBp", "label": "Systolic Blood Pressure", "group": "cardiovascular", "biomarkerKey": "systolic-bp", "inputType": "number",
      "unit": { "canonical": "mmHg" }, "validation": { "min": 60, "max": 260 }, "missingPolicy": "exclude-from-max", "order": 14 },
    { "key": "hscrp", "label": "hs-CRP", "group": "cardiovascular", "biomarkerKey": "hscrp", "inputType": "number",
      "unit": { "canonical": "mg/L", "allowed": [ { "code": "mg/L", "factor": 1 }, { "code": "mg/dL", "factor": 10 } ] },
      "validation": { "min": 0, "max": 50 }, "missingPolicy": "exclude-from-max", "order": 15 },
    { "key": "apobApoaRatio", "label": "ApoB : ApoA-I Ratio", "group": "cardiovascular", "biomarkerKey": "apob-apoa-ratio", "inputType": "number",
      "unit": { "canonical": "ratio" }, "validation": { "min": 0.1, "max": 5 }, "missingPolicy": "exclude-from-max", "order": 16 },

    { "key": "fastingGlucose", "label": "Fasting Glucose", "group": "metabolic", "biomarkerKey": "fasting-glucose", "inputType": "number",
      "unit": { "canonical": "mg/dL", "allowed": [ { "code": "mg/dL", "factor": 1 }, { "code": "mmol/L", "factor": 18.02 } ] },
      "validation": { "min": 30, "max": 600 }, "missingPolicy": "exclude-from-max", "order": 20 },
    { "key": "hba1c", "label": "HbA1c", "group": "metabolic", "biomarkerKey": "hba1c", "inputType": "number",
      "unit": { "canonical": "%" }, "validation": { "min": 3, "max": 20 }, "missingPolicy": "exclude-from-max", "order": 21 },
    { "key": "fastingInsulin", "label": "Fasting Insulin", "group": "metabolic", "biomarkerKey": "fasting-insulin", "inputType": "number",
      "unit": { "canonical": "µIU/mL" }, "validation": { "min": 0.5, "max": 300 }, "missingPolicy": "exclude-from-max", "order": 22 },
    { "key": "eag", "label": "Estimated Average Glucose", "group": "metabolic", "biomarkerKey": "eag", "inputType": "derived",
      "derived": { "formula": "28.7 * hba1c - 46.7", "dependsOn": ["hba1c"] },
      "unit": { "canonical": "mg/dL" }, "missingPolicy": "exclude-from-max", "order": 23,
      "source": { "type": "niro", "ref": "CWS PDF §3.2 scores eAG as its own parameter (C6 RESOLVED: scored separately)" } },

    { "key": "il6", "label": "IL-6", "group": "inflammatory", "biomarkerKey": "il6", "inputType": "number",
      "unit": { "canonical": "pg/mL" }, "validation": { "min": 0, "max": 1000 }, "missingPolicy": "exclude-from-max", "order": 30 },
    { "key": "crp", "label": "CRP", "group": "inflammatory", "biomarkerKey": "crp", "inputType": "number",
      "unit": { "canonical": "mg/L", "allowed": [ { "code": "mg/L", "factor": 1 }, { "code": "mg/dL", "factor": 10 } ] },
      "validation": { "min": 0, "max": 600 }, "missingPolicy": "exclude-from-max", "order": 31 },
    { "key": "esr", "label": "ESR", "group": "inflammatory", "biomarkerKey": "esr", "inputType": "number",
      "unit": { "canonical": "mm/hr" }, "validation": { "min": 0, "max": 150 }, "missingPolicy": "exclude-from-max", "order": 32 },

    { "key": "vitaminD", "label": "Vitamin D (25-OH)", "group": "nutritional", "biomarkerKey": "vitamin-d", "inputType": "number",
      "unit": { "canonical": "ng/mL", "allowed": [ { "code": "ng/mL", "factor": 1 }, { "code": "nmol/L", "factor": 0.4 } ] },
      "validation": { "min": 1, "max": 150 }, "missingPolicy": "exclude-from-max", "order": 40 },
    { "key": "vitaminB12", "label": "Vitamin B12", "group": "nutritional", "biomarkerKey": "vitamin-b12", "inputType": "number",
      "unit": { "canonical": "pg/mL", "allowed": [ { "code": "pg/mL", "factor": 1 }, { "code": "pmol/L", "factor": 1.355 } ] },
      "validation": { "min": 50, "max": 3000 }, "missingPolicy": "exclude-from-max", "order": 41 },
    { "key": "folate", "label": "Folate (serum)", "group": "nutritional", "biomarkerKey": "folate", "inputType": "number",
      "unit": { "canonical": "ng/mL", "allowed": [ { "code": "ng/mL", "factor": 1 }, { "code": "nmol/L", "factor": 0.4415 } ] },
      "validation": { "min": 0.5, "max": 50 }, "missingPolicy": "exclude-from-max", "order": 42 },
    { "key": "ferritin", "label": "Ferritin", "group": "nutritional", "biomarkerKey": "ferritin", "inputType": "number",
      "unit": { "canonical": "ng/mL", "allowed": [ { "code": "ng/mL", "factor": 1 }, { "code": "µg/L", "factor": 1 } ] },
      "validation": { "min": 1, "max": 2000 }, "missingPolicy": "exclude-from-max", "order": 43 },
    { "key": "magnesium", "label": "Magnesium (serum)", "group": "nutritional", "biomarkerKey": "magnesium", "inputType": "number",
      "unit": { "canonical": "mg/dL", "allowed": [ { "code": "mg/dL", "factor": 1 }, { "code": "mmol/L", "factor": 2.43 } ] },
      "validation": { "min": 0.5, "max": 6 }, "missingPolicy": "exclude-from-max", "order": 44 },
    { "key": "zinc", "label": "Zinc (serum)", "group": "nutritional", "biomarkerKey": "zinc", "inputType": "number",
      "unit": { "canonical": "µg/dL", "allowed": [ { "code": "µg/dL", "factor": 1 }, { "code": "µmol/L", "factor": 6.54 } ] },
      "validation": { "min": 10, "max": 400 }, "missingPolicy": "exclude-from-max", "order": 45 },

    { "key": "alt", "label": "ALT", "group": "liver", "biomarkerKey": "alt", "inputType": "number",
      "unit": { "canonical": "U/L" }, "validation": { "min": 1, "max": 2000 }, "missingPolicy": "exclude-from-max", "order": 50 },
    { "key": "ast", "label": "AST", "group": "liver", "biomarkerKey": "ast", "inputType": "number",
      "unit": { "canonical": "U/L" }, "validation": { "min": 1, "max": 2000 }, "missingPolicy": "exclude-from-max", "order": 51 },
    { "key": "ggt", "label": "GGT", "group": "liver", "biomarkerKey": "ggt", "inputType": "number",
      "unit": { "canonical": "U/L" }, "validation": { "min": 1, "max": 1500 }, "missingPolicy": "exclude-from-max", "order": 52 },
    { "key": "totalBilirubin", "label": "Total Bilirubin", "group": "liver", "biomarkerKey": "total-bilirubin", "inputType": "number",
      "unit": { "canonical": "mg/dL", "allowed": [ { "code": "mg/dL", "factor": 1 }, { "code": "µmol/L", "factor": 0.0585 } ] },
      "validation": { "min": 0, "max": 30 }, "missingPolicy": "exclude-from-max", "order": 53 },
    { "key": "albumin", "label": "Albumin", "group": "liver", "biomarkerKey": "albumin", "inputType": "number",
      "unit": { "canonical": "g/dL", "allowed": [ { "code": "g/dL", "factor": 1 }, { "code": "g/L", "factor": 0.1 } ] },
      "validation": { "min": 1, "max": 8 }, "missingPolicy": "exclude-from-max", "order": 54 },

    { "key": "egfr", "label": "eGFR", "group": "kidney", "biomarkerKey": "egfr", "inputType": "number",
      "unit": { "canonical": "mL/min/1.73m²" }, "validation": { "min": 1, "max": 200 }, "missingPolicy": "exclude-from-max", "order": 60 },
    { "key": "creatinine", "label": "Serum Creatinine", "group": "kidney", "biomarkerKey": "creatinine", "inputType": "number",
      "unit": { "canonical": "mg/dL", "allowed": [ { "code": "mg/dL", "factor": 1 }, { "code": "µmol/L", "factor": 0.0113 } ] },
      "validation": { "min": 0.1, "max": 20 }, "missingPolicy": "exclude-from-max", "order": 61 },
    { "key": "bun", "label": "BUN", "group": "kidney", "biomarkerKey": "bun", "inputType": "number",
      "unit": { "canonical": "mg/dL" }, "validation": { "min": 1, "max": 200 }, "missingPolicy": "exclude-from-max", "order": 62 },
    { "key": "uricAcid", "label": "Uric Acid", "group": "kidney", "biomarkerKey": "uric-acid", "inputType": "number",
      "unit": { "canonical": "mg/dL", "allowed": [ { "code": "mg/dL", "factor": 1 }, { "code": "µmol/L", "factor": 0.0168 } ] },
      "validation": { "min": 0.5, "max": 20 }, "missingPolicy": "exclude-from-max", "order": 63 },

    { "key": "tsh", "label": "TSH", "group": "thyroid", "biomarkerKey": "tsh", "inputType": "number",
      "unit": { "canonical": "µIU/mL", "allowed": [ { "code": "µIU/mL", "factor": 1 }, { "code": "mIU/L", "factor": 1 } ] },
      "validation": { "min": 0.01, "max": 100 }, "missingPolicy": "exclude-from-max", "order": 70 },
    { "key": "freeT4", "label": "Free T4", "group": "thyroid", "biomarkerKey": "free-t4", "inputType": "number",
      "unit": { "canonical": "ng/dL", "allowed": [ { "code": "ng/dL", "factor": 1 }, { "code": "pmol/L", "factor": 0.0777 } ] },
      "validation": { "min": 0.1, "max": 10 }, "missingPolicy": "exclude-from-max", "order": 71 },
    { "key": "freeT3", "label": "Free T3", "group": "thyroid", "biomarkerKey": "free-t3", "inputType": "number",
      "unit": { "canonical": "pg/mL", "allowed": [ { "code": "pg/mL", "factor": 1 }, { "code": "pmol/L", "factor": 0.651 } ] },
      "validation": { "min": 0.5, "max": 30 }, "missingPolicy": "exclude-from-max", "order": 72 },
    { "key": "antiTpo", "label": "Anti-TPO", "group": "thyroid", "biomarkerKey": "anti-tpo", "inputType": "number",
      "unit": { "canonical": "IU/mL" }, "validation": { "min": 0, "max": 10000 }, "missingPolicy": "exclude-from-max", "order": 73 },

    { "key": "hemoglobin", "label": "Hemoglobin", "group": "hematological", "biomarkerKey": "hemoglobin", "inputType": "number",
      "unit": { "canonical": "g/dL", "allowed": [ { "code": "g/dL", "factor": 1 }, { "code": "g/L", "factor": 0.1 } ] },
      "validation": { "min": 3, "max": 25 }, "missingPolicy": "exclude-from-max", "order": 80 },
    { "key": "mcv", "label": "MCV", "group": "hematological", "biomarkerKey": "mcv", "inputType": "number",
      "unit": { "canonical": "fL" }, "validation": { "min": 50, "max": 150 }, "missingPolicy": "exclude-from-max", "order": 81 },
    { "key": "wbc", "label": "WBC", "group": "hematological", "biomarkerKey": "wbc", "inputType": "number",
      "unit": { "canonical": "×10⁹/L", "allowed": [ { "code": "×10⁹/L", "factor": 1 }, { "code": "cells/µL", "factor": 0.001 } ] },
      "validation": { "min": 0.5, "max": 200 }, "missingPolicy": "exclude-from-max", "order": 82 },
    { "key": "platelets", "label": "Platelets", "group": "hematological", "biomarkerKey": "platelets", "inputType": "number",
      "unit": { "canonical": "×10⁹/L", "allowed": [ { "code": "×10⁹/L", "factor": 1 }, { "code": "/µL", "factor": 0.001 } ] },
      "validation": { "min": 5, "max": 2000 }, "missingPolicy": "exclude-from-max", "order": 83 },

    { "key": "cortisol", "label": "Cortisol", "group": "hormonal", "biomarkerKey": "cortisol", "inputType": "number",
      "unit": { "canonical": "µg/dL", "allowed": [ { "code": "µg/dL", "factor": 1 }, { "code": "nmol/L", "factor": 0.0362 } ] },
      "validation": { "min": 0.5, "max": 80 }, "missingPolicy": "exclude-from-max", "order": 90 },
    { "key": "testosterone", "label": "Testosterone (total)", "group": "hormonal", "biomarkerKey": "testosterone", "inputType": "number",
      "unit": { "canonical": "ng/dL", "allowed": [ { "code": "ng/dL", "factor": 1 }, { "code": "nmol/L", "factor": 28.8 } ] },
      "validation": { "min": 1, "max": 2000 }, "missingPolicy": "exclude-from-max", "order": 91 },
    { "key": "menopausalStatus", "label": "Menopausal status", "group": "hormonal", "inputType": "select",
      "visibility": { "all": [ { "param": "sex", "op": "eq", "value": "female" } ] },
      "options": [ { "value": "pre", "label": "Premenopausal" }, { "value": "post", "label": "Postmenopausal" } ],
      "validation": { "required": false }, "order": 92 },
    { "key": "estradiol", "label": "Estradiol (E2)", "group": "hormonal", "biomarkerKey": "estradiol", "inputType": "number",
      "unit": { "canonical": "pg/mL", "allowed": [ { "code": "pg/mL", "factor": 1 }, { "code": "pmol/L", "factor": 0.2725 } ] },
      "validation": { "min": 0, "max": 1000 }, "missingPolicy": "exclude-from-max", "order": 93 }
  ],

  "scoringRules": [
    { "parameterKey": "totalCholesterol", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 160, "points": 0 }, { "min": 160, "max": 200, "points": 1 }, { "min": 200, "max": 240, "points": 2 },
      { "min": 240, "max": 280, "points": 3 }, { "min": 280, "points": 4 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.1 (basis: Stone 2014)" } } ] },
    { "parameterKey": "hdl", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "min": 60, "points": -2 }, { "min": 50, "max": 60, "points": -1 }, { "min": 40, "max": 50, "points": 0 },
      { "min": 30, "max": 40, "points": 1 }, { "max": 30, "points": 2 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.1 (negative protective points)" } } ] },
    { "parameterKey": "ldl", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 70, "points": 0 }, { "min": 70, "max": 100, "points": 1 }, { "min": 100, "max": 130, "points": 2 },
      { "min": 130, "max": 160, "points": 3 }, { "min": 160, "points": 4 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.1 (basis: Grundy 2019)" } } ] },
    { "parameterKey": "triglycerides", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 100, "points": 0 }, { "min": 100, "max": 150, "points": 1 }, { "min": 150, "max": 200, "points": 2 },
      { "min": 200, "max": 500, "points": 3 }, { "min": 500, "points": 4 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.1 (basis: Miller 2011)" } } ] },
    { "parameterKey": "systolicBp", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 120, "points": 0 }, { "min": 120, "max": 130, "points": 1 }, { "min": 130, "max": 140, "points": 2 },
      { "min": 140, "max": 160, "points": 3 }, { "min": 160, "points": 4 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.1 (basis: Whelton 2018)" } } ] },
    { "parameterKey": "hscrp", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 1, "points": 0 }, { "min": 1, "max": 3, "maxInclusive": true, "points": 1 }, { "min": 3, "minExclusive": true, "points": 2 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.1 (basis: Ridker 2008 JUPITER)" } } ] },
    { "parameterKey": "apobApoaRatio", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 0.5, "points": 0 }, { "min": 0.5, "max": 0.7, "points": 1 }, { "min": 0.7, "max": 0.9, "points": 2 }, { "min": 0.9, "points": 3 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.1 (basis: Walldius 2004)" } } ] },

    { "parameterKey": "fastingGlucose", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 100, "points": 0 }, { "min": 100, "max": 126, "points": 2 }, { "min": 126, "points": 4 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.2 (basis: ADA 2020)" } } ] },
    { "parameterKey": "hba1c", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 5.7, "points": 0 }, { "min": 5.7, "max": 6.5, "points": 2 }, { "min": 6.5, "points": 4 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.2" } } ] },
    { "parameterKey": "fastingInsulin", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 10, "points": 0 }, { "min": 10, "max": 15, "maxInclusive": true, "points": 1 }, { "min": 15, "minExclusive": true, "points": 2 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.2 (basis: Laakso 2015) — C9 RESOLVED for insulin" } } ] },
    { "parameterKey": "eag", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 100, "points": 0 }, { "min": 100, "max": 126, "points": 1 }, { "min": 126, "max": 155, "points": 2 }, { "min": 155, "points": 3 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.2 (basis: Nathan 2008)" } } ] },

    { "parameterKey": "il6", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 1.0, "points": 0 }, { "min": 1.0, "max": 3.0, "maxInclusive": true, "points": 1 }, { "min": 3.0, "minExclusive": true, "points": 2 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.3 (basis: Ridker 2000) — C9 RESOLVED for IL-6" } } ] },
    { "parameterKey": "crp", "bandEdges": "min-inclusive", "contexts": [ { "when": null, "bands": [
      { "max": 1, "points": 0 }, { "min": 1, "max": 3, "points": 1 }, { "min": 3, "max": 10, "maxInclusive": true, "points": 2 }, { "min": 10, "minExclusive": true, "points": 3 } ],
      "source": { "type": "niro", "ref": "CWS PDF §3.3" } } ] },
