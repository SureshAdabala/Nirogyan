{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:niro:schema:content-page:v1",
  "title": "Niro Calculator Content Page v1",
  "description": "Structured calculator-associated page content with claim-level evidence, authorship, SEO, lifecycle, and medical review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentId",
    "version",
    "locale",
    "slug",
    "title",
    "summary",
    "blocks",
    "claims",
    "citations",
    "authorship",
    "medicalReview",
    "seo",
    "publication"
  ],
  "properties": {
    "schemaVersion": { "const": "content-page.v1" },
    "contentId": { "$ref": "#/$defs/slug" },
    "version": { "type": "integer", "minimum": 1 },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
      "default": "en-IN"
    },
    "slug": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contentBlock" }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "citations": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "authorship": { "$ref": "#/$defs/authorship" },
    "medicalReview": { "$ref": "#/$defs/medicalReview" },
    "seo": { "$ref": "#/$defs/seo" },
    "publication": { "$ref": "#/$defs/publication" },
    "related": { "$ref": "#/$defs/related" }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 120
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
      "minLength": 1,
      "maxLength": 120
    },
    "blockBase": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "type": { "type": "string" },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "markdownBlock": {
      "allOf": [
        { "$ref": "#/$defs/blockBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "markdown"],
          "properties": {
            "id": { "$ref": "#/$defs/key" },
            "type": { "const": "markdown" },
            "markdown": { "type": "string", "minLength": 1, "maxLength": 50000 },
            "claimIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/key" }
            }
          }
        }
      ]
    },
    "calloutBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "tone", "markdown"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "type": { "const": "callout" },
        "tone": { "enum": ["information", "caution", "warning", "success"] },
        "title": { "type": "string", "maxLength": 200 },
        "markdown": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "faqItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "answerMarkdown"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "question": { "type": "string", "minLength": 1, "maxLength": 500 },
        "answerMarkdown": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "faqBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "type": { "const": "faq" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/faqItem" }
        },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "stepsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "type": { "const": "steps" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "markdown"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 300 },
              "markdown": { "type": "string", "minLength": 1, "maxLength": 5000 },
              "claimIds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/key" }
              }
            }
          }
        },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "tableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "caption", "headers", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "type": { "const": "table" },
        "caption": { "type": "string", "minLength": 1, "maxLength": 500 },
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "maxLength": 2000 }
          }
        },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "mediaBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "assetId", "alt"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "type": { "const": "media" },
        "assetId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "alt": { "type": "string", "minLength": 1, "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 1000 },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "relatedBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "type": { "const": "related" },
        "calculatorSlugs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "measurementKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "contentSlugs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      },
      "anyOf": [
        { "required": ["calculatorSlugs"] },
        { "required": ["measurementKeys"] },
        { "required": ["contentSlugs"] }
      ]
    },
    "disclaimerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "markdown"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "type": { "const": "disclaimer" },
        "markdown": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "calculatorEmbedBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "calculatorSlug"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "type": { "const": "calculator-embed" },
        "calculatorSlug": { "$ref": "#/$defs/slug" },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "crisisResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "label", "contact"],
      "properties": {
        "region": { "type": "string", "minLength": 1, "maxLength": 100 },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 },
        "contact": { "type": "string", "minLength": 1, "maxLength": 500 },
        "url": { "type": "string", "format": "uri", "maxLength": 2000 }
      }
    },
    "crisisBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "triggerRef", "markdown", "resources"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "type": { "const": "crisis-resources" },
        "triggerRef": { "type": "string", "minLength": 1, "maxLength": 500 },
        "markdown": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/crisisResource" }
        },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "contentBlock": {
      "oneOf": [
        { "$ref": "#/$defs/markdownBlock" },
        { "$ref": "#/$defs/calloutBlock" },
        { "$ref": "#/$defs/faqBlock" },
        { "$ref": "#/$defs/stepsBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/mediaBlock" },
        { "$ref": "#/$defs/relatedBlock" },
        { "$ref": "#/$defs/disclaimerBlock" },
        { "$ref": "#/$defs/calculatorEmbedBlock" },
        { "$ref": "#/$defs/crisisBlock" }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "kind", "citationIds", "reviewStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "text": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "kind": {
          "enum": [
            "medical-fact",
            "threshold",
            "formula",
            "recommendation",
            "product-description",
            "disclaimer",
            "nonmedical"
          ]
        },
        "citationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        },
        "reviewStatus": { "enum": ["unreviewed", "verified", "disputed", "expired", "not-applicable"] },
        "reviewNote": { "type": "string", "maxLength": 2000 }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "verificationStatus", "licenseStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "type": { "enum": ["niro", "guideline", "government", "journal", "reference", "internal"] },
        "org": { "type": "string", "maxLength": 300 },
        "authors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "url": { "type": "string", "format": "uri", "maxLength": 2000 },
        "localRef": { "type": "string", "maxLength": 1000 },
        "identifier": { "type": "string", "maxLength": 300 },
        "publishedAt": { "type": "string", "format": "date" },
        "accessedAt": { "type": "string", "format": "date" },
        "verificationStatus": {
          "enum": ["fetch-verified", "source-provided", "search-verified", "blocked-cited", "needs-verification"]
        },
        "licenseStatus": { "enum": ["clear", "permission-required", "licensed", "unknown", "not-applicable"] },
        "primarySource": { "type": "boolean" },
        "reviewExpiresAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "maxLength": 2000 }
      },
      "anyOf": [{ "required": ["url"] }, { "required": ["localRef"] }]
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "role": { "enum": ["author", "editor", "medical-reviewer", "source-reviewer"] },
        "credentials": { "type": "string", "maxLength": 500 },
        "profileSlug": { "$ref": "#/$defs/slug" }
      }
    },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contributors", "ownerId", "createdAt", "updatedAt"],
      "properties": {
        "contributors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contributor" }
        },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "medicalReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope", "reviewerId", "reviewedAt", "nextReviewAt", "decisionNote"],
      "properties": {
        "status": { "enum": ["unreviewed", "in-review", "approved", "changes-requested", "rejected", "expired", "not-applicable"] },
        "scope": { "enum": ["content-only", "clinical-claims", "full-page", "not-applicable"] },
        "reviewerId": { "type": ["string", "null"], "maxLength": 200 },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
        "nextReviewAt": { "type": ["string", "null"], "format": "date-time" },
        "decisionNote": { "type": ["string", "null"], "maxLength": 3000 },
        "approvedClaimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "socialImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "alt"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "alt": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metaTitle", "metaDescription", "canonicalPath", "robots", "schemaTypes"],
      "properties": {
        "metaTitle": { "type": "string", "minLength": 15, "maxLength": 65 },
        "metaDescription": { "type": "string", "minLength": 50, "maxLength": 170 },
        "canonicalPath": { "type": "string", "pattern": "^/", "maxLength": 500 },
        "robots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "follow"],
          "properties": {
            "index": { "type": "boolean" },
            "follow": { "type": "boolean" }
          }
        },
        "schemaTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["WebPage", "MedicalWebPage", "FAQPage", "SoftwareApplication", "BreadcrumbList"]
          }
        },
        "openGraph": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "maxLength": 100 },
            "description": { "type": "string", "maxLength": 300 },
            "image": { "$ref": "#/$defs/socialImage" }
          }
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "redirectsFrom": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/", "maxLength": 500 }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "publishedAt", "retiredAt", "changelog"],
      "properties": {
        "status": { "enum": ["draft", "in-review", "approved", "published", "retired"] },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "retiredAt": { "type": ["string", "null"], "format": "date-time" },
        "changelog": { "type": "string", "maxLength": 3000 },
        "replacementSlug": { "$ref": "#/$defs/slug" }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calculatorSlugs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "measurementKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "contentSlugs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    }
  }
}
