{
  "name": "@niro/client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && node ../../scripts/prepare-next-standalone.mjs",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev",
    "start": "node .next/standalone/apps/client/server.js",
    "test": "vitest run --config ../../vitest.config.ts --no-file-parallelism --testTimeout 60000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@niro/contracts": "*",
    "@tanstack/react-query": "5.104.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "next": "^16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vitest-axe": "^0.1.0"
  }
}
